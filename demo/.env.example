# OpenClaw 十模組 Demo — 環境變數範本
#
# 用法：複製為 .env 後填入真實值，或直接設為系統環境變數。
#   Windows（永久）: setx ANTHROPIC_API_KEY "sk-ant-..."
#   Git Bash（當次） : export ANTHROPIC_API_KEY="sk-ant-..."
#
# 鐵律：
#   1. .env 必須列入 .gitignore，永遠不 commit。
#   2. 本檔只放「變數名稱與說明」，不得出現任何真實金鑰。
#   3. config.yaml 一律寫 ${VAR}，由 _shared/config_loader.py 展開；
#      程式碼裡不得出現字串常數金鑰。
#   4. --mock 模式（預設）不需要任何一項變數；只有 --live 或
#      --notify 指定外送通道時才需要對應憑證。

# ---------------------------------------------------------------
# Claude API（--live 模式必要）
# ---------------------------------------------------------------
# _shared/llm_client.py 讀取。缺少時走紅色警報退出，不會靜默降級回 mock。
ANTHROPIC_API_KEY=

# token 用量記錄檔的完整路徑（選填）。
# 未設定時預設寫入 demo/.usage.jsonl；刻意不跟著目前工作目錄（cwd）走，
# 否則從別的目錄執行就會把記錄檔灑進不相干的 repo，而且各自獨立無法彙整。
# 設定時請給「檔案完整路徑」而非目錄，目錄不存在會自動建立。
# 例：OPENCLAW_USAGE_LOG=%USERPROFILE%\openclaw\usage.jsonl
#     OPENCLAW_USAGE_LOG=~/openclaw/usage.jsonl
OPENCLAW_USAGE_LOG=

# ---------------------------------------------------------------
# 通知通道：telegram（--notify telegram，台灣主力通道）
# ---------------------------------------------------------------
# BotFather 建立 Bot 後取得的 token，格式 <數字>:<英數字串>
TELEGRAM_BOT_TOKEN=
# 接收訊息的 chat id（個人聊天為正整數，群組為負整數）
TELEGRAM_CHAT_ID_CHENGHYANG2001BOT=

# ---------------------------------------------------------------
# 通知通道：gmail（--notify gmail）
# ---------------------------------------------------------------
# 收件人 email。寄件走已登入的 gws CLI，因此不需要在此放 OAuth 憑證
# （書中紅色警報「Gmail token 7 天過期」就是自行做 OAuth 造成的）。
GMAIL_TO=

# ---------------------------------------------------------------
# 通知通道：line（--notify line）
# ---------------------------------------------------------------
# LINE Developers -> Messaging API -> Channel access token（long-lived）
LINE_CHANNEL_TOKEN=
# push 目標的 userId / groupId / roomId
LINE_TO=

# ---------------------------------------------------------------
# 通知通道：whatsapp（--notify whatsapp，原書英國市場用）
# ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# 發送門號，沙盒格式為 whatsapp:+14155238886
TWILIO_FROM=
# 收件門號，格式 whatsapp:+886912345678
TWILIO_TO=

# ---------------------------------------------------------------
# Windows 執行環境（強烈建議）
# ---------------------------------------------------------------
# 系統預設 cp950，未設此值時印出繁中會有 UnicodeEncodeError 風險。
PYTHONUTF8=1
